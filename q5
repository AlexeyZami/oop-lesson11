#include <stdio.h>

#define SIZE 10

int input(int *arr);
void sort(int *arr);
void output(int *arr);

int main() {
    int arr[SIZE];

    if (input(arr) == 0) {
        printf("n/a");
        return 1;
    }

    sort(arr);
    output(arr);

    return 0;
}

int input(int *arr) {
    int i;

    for (i = 0; i < SIZE; i++) {
        if (scanf("%d", &arr[i]) != 1) {
            return 0;
        }
    }

    return 1;
}

void sort(int *arr) {
    int i, j, temp;

    for (i = 0; i < SIZE - 1; i++) {
        for (j = 0; j < SIZE - 1 - i; j++) {
            if (arr[j] > arr[j + 1]) {
                temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }
}

void output(int *arr) {
    int i;

    for (i = 0; i < SIZE; i++) {
        if (i != SIZE - 1) {
            printf("%d ", arr[i]);
        } else {
            printf("%d", arr[i]);
        }
    }
}